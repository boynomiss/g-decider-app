{
  "name": "g-decider-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "EXPO_ROUTER_APP_ROOT=src/app expo start",
    "start-web": "EXPO_ROUTER_APP_ROOT=src/app expo start --web",
    "start-clear": "EXPO_ROUTER_APP_ROOT=src/app expo start --clear",
    "build": "EXPO_ROUTER_APP_ROOT=src/app expo build",
    "build-web": "EXPO_ROUTER_APP_ROOT=src/app expo build --web",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "type-check": "tsc --noEmit",
    "audit-db": "ts-node --project tsconfig.scripts.json scripts/audit-database.ts",
    "populate-db": "ts-node --project tsconfig.scripts.json scripts/populate-database.ts",
    "populate-bulacan": "ts-node --project tsconfig.scripts.json scripts/populate-bulacan-places.ts",
    "place-helper": "ts-node --project tsconfig.scripts.json scripts/place-generator-helper.ts",
    "fetch-images": "ts-node --project tsconfig.scripts.json scripts/fetch-and-update-images.ts",
    "update-streetview": "ts-node --project tsconfig.scripts.json scripts/update-with-streetview-images.ts",
    "update-maps": "ts-node --project tsconfig.scripts.json scripts/update-with-maps-only.ts",
    "fix-images-now": "ts-node --project tsconfig.scripts.json scripts/update-with-working-images.ts",
    "use-picsum": "ts-node --project tsconfig.scripts.json scripts/update-with-lorem-picsum.ts",
    "fetch-real-photos": "ts-node --project tsconfig.scripts.json scripts/fetch-real-place-photos.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/slider": "^5.0.1",
    "@react-native-picker/picker": "^2.11.1",
    "expo": "^54.0.10",
    "expo-linear-gradient": "~15.0.7",
    "expo-router": "~6.0.8",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "firebase": "^10.8.0",
    "lucide-react-native": "^0.542.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "^0.81.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.1",
    "react-native-worklets": "^0.6.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  }
}
